# ================================================================
# Anadolu Atlası - Ortam Değişkenleri
# ================================================================
# Bu dosyayı kopyalayıp .env olarak kaydedin:
#   cp .env.example .env
#
# .env dosyası git'e eklenmemelidir.
# ================================================================

# ---- PostgreSQL ----
POSTGRES_DB=anadolu_atlasi
POSTGRES_USER=anadolu
POSTGRES_PASSWORD=anadolu_dev
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- MinIO ----
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_BUCKET=anadolu-media
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Backend ----
BACKEND_PORT=8080

# ---- Admin Web ----
ADMIN_WEB_PORT=5173
