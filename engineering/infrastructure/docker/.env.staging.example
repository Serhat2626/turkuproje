# ================================================================
# Anadolu Atlası - Staging Ortam Değişkenleri (Real Provider)
# ================================================================
# Bu dosyayı kopyalayıp .env.staging olarak kaydedin:
#   cp .env.staging.example .env.staging
#
# .env.staging dosyası git'e eklenmemelidir (.gitignore'da .env var).
#
# OPENAI_API_KEY değerini güvenli şekilde doldurun.
# ================================================================

# ---- PostgreSQL (Staging — ayrı DB) ----
POSTGRES_DB=anadolu_atlasi_staging
POSTGRES_USER=anadolu_staging
POSTGRES_PASSWORD=staging_secure_password_change_me
POSTGRES_PORT=5433

# ---- Redis ----
REDIS_HOST=redis-staging
REDIS_PORT=6380

# ---- MinIO ----
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_staging_123
MINIO_BUCKET=anadolu-media-staging
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# ---- Backend ----
BACKEND_PORT=8081

# ---- Admin Web ----
ADMIN_WEB_PORT=5174

# ---- AI Provider (Real Provider) ----
AI_PROVIDER=openai
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
